{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Okja v4 audio clip manifest row",
  "type": "object",
  "required": [
    "clip_id", "audio_path", "audio_sha256", "language", "label", "text", "script_id",
    "source_id", "source_license", "tts_engine", "tts_engine_version", "voice_id", "generation_seed",
    "base_audio_id", "split", "sample_rate_hz", "channels", "duration_ms", "qc_status"
  ],
  "properties": {
    "clip_id": {"type": "string", "minLength": 1},
    "audio_path": {"type": "string", "minLength": 1},
    "audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "language": {"enum": ["ko", "en"]},
    "label": {"enum": ["positive", "negative", "hard_negative", "mention_context"]},
    "wake_variant": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "normalized_text": {"type": "string"},
    "script_id": {"type": "string", "minLength": 1},
    "template_id": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "source_license": {"type": "string"},
    "tts_engine": {"type": "string", "minLength": 1},
    "tts_engine_version": {"type": "string", "minLength": 1},
    "voice_id": {"type": "string", "minLength": 1},
    "generation_seed": {"type": ["integer", "string"]},
    "base_audio_id": {"type": "string", "minLength": 1},
    "augmentation_id": {"type": "string"},
    "holdout_role": {"type": "string"},
    "split": {"enum": ["train", "validation", "test_speaker", "test_engine", "test_real", "test_household", "quarantine"]},
    "sample_rate_hz": {"type": "integer", "minimum": 8000},
    "channels": {"type": "integer", "minimum": 1, "maximum": 2},
    "duration_ms": {"type": "integer", "minimum": 1},
    "peak_abs": {"type": "number", "minimum": 0},
    "rms": {"type": "number", "minimum": 0},
    "silence_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "dc_offset": {"type": "number"},
    "loudness_dbfs": {"type": ["number", "string"]},
    "finite_samples": {"type": ["boolean", "string"]},
    "qc_status": {"enum": ["pending", "pass", "fail", "review"]},
    "qc_reasons": {"type": ["array", "string"], "items": {"type": "string"}},
    "pronunciation_status": {"enum": ["not_reviewed", "pass", "fail", "unsure"]},
    "created_by": {"type": "string"}
  },
  "additionalProperties": true
}
