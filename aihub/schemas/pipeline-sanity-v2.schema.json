{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "okja.pipeline-sanity.v2",
  "title": "Project Okja pipeline sanity run v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "phrase_id",
    "prompt_text",
    "capture_epoch",
    "pcm_start_sample",
    "pcm_end_sample",
    "continuity_ok",
    "wake_engine",
    "wake_model_name",
    "wake_model_sha256",
    "wake_config_sha256",
    "wake_detector_init_ms",
    "wake_engine_warmup_ms",
    "wake_frame_index",
    "wake_decision_sample",
    "keyword_end_sample",
    "keyword_end_to_wake_ms",
    "onset_to_wake_ms",
    "preroll_start_sample",
    "asr_init_ms",
    "asr_decode_ms",
    "asr_finalize_ms",
    "transcript",
    "apk_sha256"
  ],
  "properties": {
    "schema": { "const": "okja.pipeline-sanity.v2" },
    "run_id": { "type": "string", "minLength": 1 },
    "phrase_id": { "type": "string", "pattern": "^S(0[1-9]|1[0-2])$" },
    "prompt_text": { "type": "string", "minLength": 1 },
    "capture_epoch": { "type": "integer", "minimum": 1 },
    "pcm_start_sample": { "type": "integer", "minimum": 0 },
    "pcm_end_sample": { "type": "integer", "minimum": 1 },
    "continuity_ok": { "const": true },
    "wake_engine": { "type": "string", "minLength": 1 },
    "wake_model_name": { "type": ["string", "null"] },
    "wake_model_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "wake_config_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "wake_detector_init_ms": { "type": ["number", "null"], "minimum": 0 },
    "wake_engine_warmup_ms": { "type": ["number", "null"], "minimum": 0 },
    "wake_frame_index": { "type": ["integer", "null"], "minimum": 0 },
    "wake_decision_sample": { "type": ["integer", "null"], "minimum": 0 },
    "keyword_end_sample": { "type": ["integer", "null"], "minimum": 0 },
    "keyword_end_to_wake_ms": { "type": ["number", "null"] },
    "onset_to_wake_ms": { "type": ["number", "null"] },
    "preroll_start_sample": { "type": ["integer", "null"], "minimum": 0 },
    "asr_init_ms": { "type": ["number", "null"], "minimum": 0 },
    "asr_decode_ms": { "type": ["number", "null"], "minimum": 0 },
    "asr_finalize_ms": { "type": ["number", "null"], "minimum": 0 },
    "transcript": { "type": ["string", "null"] },
    "apk_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
